# Copy to .env for local development. Never commit real secrets.
AURA_ENV=dev
AURA_REGION=in
AURA_DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura
# Redis clusters are split by workload in prod; in dev all three point at one instance.
AURA_REDIS_STATE_URL=redis://localhost:6379/0
AURA_REDIS_CACHE_URL=redis://localhost:6379/1
AURA_REDIS_VECTOR_URL=redis://localhost:6380/0
AURA_NATS_URL=nats://localhost:4222
AURA_CLICKHOUSE_URL=http://localhost:8123
AURA_S3_ENDPOINT=http://localhost:9000
AURA_S3_BUCKET=aura-dev
# 32-byte base64 master key for envelope encryption (dev only; prod uses KMS).
AURA_MASTER_KEY=

# --- model providers (platform keys; leave empty to disable) ---
AURA_ANTHROPIC_API_KEY=
AURA_OPENAI_API_KEY=
AURA_OPENROUTER_API_KEY=
# Groq: fast open-weight models through an OpenAI-compatible API.
AURA_GROQ_API_KEY=
# Sub-query decomposition mode: false = sub-questions (default), true = sub-tasks
AURA_SUBQUERY_AS_TASKS=false


# --- auth ---
AURA_PUBLIC_WEB_URL=http://localhost:3000
AURA_PUBLIC_API_URL=http://localhost:8000
AURA_COOKIE_SECURE=false
# Peppers the API-key HMAC. Rotating it invalidates every issued key.
AURA_API_KEY_PEPPER=
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=

# --- mail (Mailpit locally: http://localhost:8025) ---
AURA_SMTP_HOST=localhost
AURA_SMTP_PORT=1025
AURA_MAIL_FROM=AURA <no-reply@aura.local>

# --- billing (Razorpay test mode) ---
AURA_RAZORPAY_KEY_ID=
AURA_RAZORPAY_KEY_SECRET=
AURA_RAZORPAY_WEBHOOK_SECRET=
